*.VC.db
*.opensdf
*.opendb
*.sdf
*.sln
*.suo

# OS cruft
Desktop.ini
Thumbs.db
.DS_Store

# Python scratch files from the pipelines folder. Rebuilt automatically.
__pycache__/
*.pyc

# Scaffolding for the itch.io page, not part of the project
itch-page-copy.md
